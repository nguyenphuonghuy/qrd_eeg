#!/bin/bash
#PBS -N wt_fixed_resume
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=32gb:gpu_slots=1
#PBS -l walltime=03:00:00
#PBS -j oe

LOG=/gpfs0/users/gv_nphuy/projects/qrd_eeg/logs/wt_fixed_resume.log
mkdir -p "$(dirname "$LOG")"
exec > "$LOG" 2>&1

echo "===== START $(date +%T) $(date +%F) node=$(hostname) (resume wt_fixed: chi seed 5, seed 1-4 da co 412 dong hop le) ====="
export PYTHONUNBUFFERED=1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null

PROJ=/gpfs0/users/gv_nphuy/projects/qrd_eeg
export ENSEMBLE_MI_DIR=$PROJ/external/Ensemble-MI
export QRD_TEACHER_DIR=$PROJ/checkpoints
export QRD_OUT_DIR=$PROJ/results/wt_fixed_control_2026_08_05
mkdir -p "$QRD_OUT_DIR"

PY=/gpfs0/users/gv_nphuy/envs/qrd_env/bin/python
cd "$ENSEMBLE_MI_DIR" || { echo "LOI cd repo"; exit 2; }

export QRD_DATASET=PhysionetMI
export QRD_SEEDS="5"
export QRD_RUNS="wt_fixed:qrd_dense_wtfixed"
export QRD_SEEDS_OUT="wtfixed_seed5_resume.csv"

timeout 9000 $PY $PROJ/scripts/run_seeds.py
echo "rc=$?"
echo "rows: $(tail -n +2 $QRD_OUT_DIR/wtfixed_seed5_resume.csv 2>/dev/null | wc -l) (dich 103 = 1 seed x 103 subject)"

echo "===== END $(date +%T) ====="
