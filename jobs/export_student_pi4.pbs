#!/bin/bash
#PBS -N export_student_pi4
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=32gb:gpu_slots=1
#PBS -l walltime=00:20:00
#PBS -j oe

LOG=/gpfs0/users/gv_nphuy/projects/qrd_eeg/logs/export_student_pi4.log
mkdir -p "$(dirname "$LOG")"
exec > "$LOG" 2>&1

echo "===== START $(date +%T) $(date +%F) node=$(hostname) (xuat TorchScript student cho benchmark Pi4) ====="
export PYTHONUNBUFFERED=1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null

PROJ=/gpfs0/users/gv_nphuy/projects/qrd_eeg
export ENSEMBLE_MI_DIR=$PROJ/external/Ensemble-MI

PY=/gpfs0/users/gv_nphuy/envs/qrd_env/bin/python
cd "$ENSEMBLE_MI_DIR" || { echo "LOI cd repo"; exit 2; }

$PY $PROJ/scripts/export_student_pi4.py
echo "rc=$?"

echo "===== END $(date +%T) ====="
