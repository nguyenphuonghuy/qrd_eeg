#!/bin/bash
#PBS -N no_kd_alpha1
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=64gb:gpu_slots=1
#PBS -l walltime=02:00:00
#PBS -j oe

LOG=/gpfs0/users/gv_nphuy/projects/qrd_eeg/logs/no_kd_alpha1_seeds.log
mkdir -p "$(dirname "$LOG")"
exec > "$LOG" 2>&1

echo "===== START $(date +%T) $(date +%F) node=$(hostname) (no_kd alpha=1.0 x5 seed, kiem tra baseline yeu do alpha=0.5) ====="
export PYTHONUNBUFFERED=1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null

PROJ=/gpfs0/users/gv_nphuy/projects/qrd_eeg
export ENSEMBLE_MI_DIR=$PROJ/external/Ensemble-MI
export QRD_TEACHER_DIR=$PROJ/checkpoints
export QRD_OUT_DIR=$PROJ/results/no_kd_alpha1_2026_08_03
mkdir -p "$QRD_OUT_DIR"

export QRD_DATASET=PhysionetMI
export QRD_SEEDS="1,2,3,4,5"
export QRD_SEEDS_OUT="no_kd_alpha1_per_subject.csv"
export QRD_RUNS="no_kd:no_kd"
export QRD_ALPHA=1.0

PY=/gpfs0/users/gv_nphuy/envs/qrd_env/bin/python

cd "$ENSEMBLE_MI_DIR" || { echo "LOI cd repo"; exit 2; }

echo "teacher ckpt: $(ls $QRD_TEACHER_DIR/teacher_fold0*.pth 2>/dev/null | wc -l)"
echo "xac nhan HP.alpha se doc QRD_ALPHA:"
grep -n "QRD_ALPHA" "$PROJ/scripts/run_seeds.py"
echo "RUNS=$QRD_RUNS SEEDS=$QRD_SEEDS ALPHA=$QRD_ALPHA"

( while true; do
    MEM=$(ps -u gv_nphuy -o rss= 2>/dev/null | awk '{s+=$1}END{printf "%.1fGB", s/1048576}')
    echo "[HB $(date +%T)] procmem=$MEM"
    sleep 300
  done ) &
HB=$!

timeout 6600 $PY $PROJ/scripts/run_seeds.py ; echo "rc=$?"
kill $HB 2>/dev/null

echo "rows: $(tail -n +2 $QRD_OUT_DIR/no_kd_alpha1_per_subject.csv 2>/dev/null | wc -l) (dich 515 = 5 seed x 103 subject)"
echo "===== END $(date +%T) ====="
