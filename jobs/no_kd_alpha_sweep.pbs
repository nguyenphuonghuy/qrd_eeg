#!/bin/bash
#PBS -N no_kd_alpha_sweep
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=64gb:gpu_slots=1
#PBS -l walltime=06:00:00
#PBS -j oe

LOG=/gpfs0/users/gv_nphuy/projects/qrd_eeg/logs/no_kd_alpha_sweep.log
mkdir -p "$(dirname "$LOG")"
exec > "$LOG" 2>&1

echo "===== START $(date +%T) $(date +%F) node=$(hostname) (bang do nhay alpha cho no_kd, PhysionetMI, alpha in {0.0,0.25,0.75}; alpha=0.5 va 1.0 da co san) ====="
export PYTHONUNBUFFERED=1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null

PROJ=/gpfs0/users/gv_nphuy/projects/qrd_eeg
export ENSEMBLE_MI_DIR=$PROJ/external/Ensemble-MI
export QRD_TEACHER_DIR=$PROJ/checkpoints
export QRD_OUT_DIR=$PROJ/results/no_kd_alpha_sweep_2026_08_04
mkdir -p "$QRD_OUT_DIR"

export QRD_DATASET=PhysionetMI
export QRD_SEEDS="1,2,3,4,5"
export QRD_RUNS="no_kd:no_kd"

PY=/gpfs0/users/gv_nphuy/envs/qrd_env/bin/python

cd "$ENSEMBLE_MI_DIR" || { echo "LOI cd repo"; exit 2; }

echo "teacher ckpt: $(ls $QRD_TEACHER_DIR/teacher_fold0*.pth 2>/dev/null | wc -l)"

( while true; do
    MEM=$(ps -u gv_nphuy -o rss= 2>/dev/null | awk '{s+=$1}END{printf "%.1fGB", s/1048576}')
    echo "[HB $(date +%T)] procmem=$MEM"
    sleep 300
  done ) &
HB=$!

for ALPHA in 0.0 0.25 0.75; do
  export QRD_ALPHA=$ALPHA
  export QRD_SEEDS_OUT="no_kd_alpha${ALPHA}_per_subject.csv"
  echo "----- ALPHA=$ALPHA OUT=$QRD_SEEDS_OUT -----"
  timeout 5400 $PY $PROJ/scripts/run_seeds.py ; echo "alpha=$ALPHA rc=$?"
  echo "rows: $(tail -n +2 $QRD_OUT_DIR/$QRD_SEEDS_OUT 2>/dev/null | wc -l) (dich 515 = 5 seed x 103 subject)"
done

kill $HB 2>/dev/null
echo "===== END $(date +%T) ====="
