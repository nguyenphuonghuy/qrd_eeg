#!/bin/bash
#PBS -N fact_qden
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=16gb:gpu_slots=1
#PBS -l walltime=10:00:00
#PBS -j oe

LOG=/gpfs0/users/gv_nphuy/projects/qrd_eeg/logs/factorial_qdense.log
mkdir -p "$(dirname "$LOG")"
exec > "$LOG" 2>&1

echo "===== START $(date +%T) $(date +%F) node=$(hostname) (Giai thua: luong tu x dense, xem docs/PREREG_ADDENDUM_FACTORIAL_2026_10_25.md) ====="
export PYTHONUNBUFFERED=1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null
export OMP_NUM_THREADS=${NCPUS:-8}
export MKL_NUM_THREADS=${NCPUS:-8}

PROJ=/gpfs0/users/gv_nphuy/projects/qrd_eeg
export ENSEMBLE_MI_DIR=$PROJ/external/Ensemble-MI
export QRD_TEACHER_DIR=$PROJ/checkpoints
export QRD_OUT_DIR=$PROJ/results/factorial_2026_10_25
mkdir -p "$QRD_OUT_DIR"

PY=/gpfs0/users/gv_nphuy/envs/qrd_env/bin/python
cd "$ENSEMBLE_MI_DIR" || { echo "LOI cd repo"; exit 2; }

export QRD_DATASET=PhysionetMI
export QRD_SEEDS="1,2,3,4,5"
export QRD_RUNS="qrd_dense_b0.02:qrd_dense:0.02"
export QRD_SEEDS_OUT="factorial_qdense_per_subject.csv"

( while true; do
    MEM=$(ps -u gv_nphuy -o rss= 2>/dev/null | awk '{s+=$1}END{printf "%.1fGB", s/1048576}')
    echo "[HB $(date +%T)] procmem=$MEM"
    sleep 600
  done ) &
HB=$!

timeout 34200 $PY $PROJ/scripts/run_seeds.py ; echo "rc=$?"
kill $HB 2>/dev/null

echo "rows: $(tail -n +2 $QRD_OUT_DIR/factorial_qdense_per_subject.csv 2>/dev/null | wc -l) (dich 515 = 1 run x 5 seed x 103 subject)"
echo "===== END $(date +%T) ====="
