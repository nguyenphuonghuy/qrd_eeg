#!/bin/bash
#PBS -N tsne_feats
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=32gb:gpu_slots=1
#PBS -l walltime=01:00:00
#PBS -j oe

LOG=/gpfs0/users/gv_nphuy/projects/qrd_eeg/logs/tsne_feats.log
mkdir -p "$(dirname "$LOG")"
exec > "$LOG" 2>&1

echo "===== START $(date +%T) $(date +%F) node=$(hostname) (trich dac trung test cho Hinh 3 - Van de 12) ====="
export PYTHONUNBUFFERED=1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null

PROJ=/gpfs0/users/gv_nphuy/projects/qrd_eeg
export ENSEMBLE_MI_DIR=$PROJ/external/Ensemble-MI
export QRD_TEACHER_DIR=$PROJ/checkpoints
export QRD_OUT_DIR=$PROJ/results/tsne_feats_2026_08_03
mkdir -p "$QRD_OUT_DIR"

export QRD_DATASET=PhysionetMI
export QRD_TSNE_FOLD=0
export QRD_TSNE_SEED=1

PY=/gpfs0/users/gv_nphuy/envs/qrd_env/bin/python
cd "$ENSEMBLE_MI_DIR" || { echo "LOI cd repo"; exit 2; }

echo "teacher ckpt: $(ls $QRD_TEACHER_DIR/teacher_fold0*.pth 2>/dev/null | wc -l)"

( while true; do
    MEM=$(ps -u gv_nphuy -o rss= 2>/dev/null | awk '{s+=$1}END{printf "%.1fGB", s/1048576}')
    echo "[HB $(date +%T)] procmem=$MEM"
    sleep 300
  done ) &
HB=$!

timeout 3000 $PY $PROJ/scripts/extract_tsne_feats.py ; echo "rc=$?"
kill $HB 2>/dev/null

echo "----- file ket qua -----"
ls -la $QRD_OUT_DIR/
echo "===== END $(date +%T) ====="
