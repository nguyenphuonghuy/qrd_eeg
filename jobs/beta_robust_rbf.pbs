#!/bin/bash
#PBS -N beta_rbf
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=16gb:gpu_slots=1
#PBS -l walltime=11:00:00
#PBS -j oe

LOG=/gpfs0/users/gv_nphuy/projects/qrd_eeg/logs/beta_robust_rbf.log
mkdir -p "$(dirname "$LOG")"
exec > "$LOG" 2>&1

echo "===== START $(date +%T) $(date +%F) node=$(hostname) (Phu luc beta: RBF 0.2 (nhanh M), 0.1, 0.5, xem docs/PREREG_ADDENDUM_BETA_2026_10_24.md) ====="
export PYTHONUNBUFFERED=1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null
export OMP_NUM_THREADS=${NCPUS:-8}
export MKL_NUM_THREADS=${NCPUS:-8}

PROJ=/gpfs0/users/gv_nphuy/projects/qrd_eeg
export ENSEMBLE_MI_DIR=$PROJ/external/Ensemble-MI
export QRD_TEACHER_DIR=$PROJ/checkpoints
export QRD_OUT_DIR=$PROJ/results/beta_robust_2026_10_24
mkdir -p "$QRD_OUT_DIR"

PY=/gpfs0/users/gv_nphuy/envs/qrd_env/bin/python
cd "$ENSEMBLE_MI_DIR" || { echo "LOI cd repo"; exit 2; }

export QRD_DATASET=PhysionetMI
export QRD_SEEDS="1,2,3,4,5"
export QRD_RUNS="ck_rbf_tg_b0.2:ck_rbf_tg:0.2,ck_rbf_tg_b0.1:ck_rbf_tg:0.1,ck_rbf_tg_b0.5:ck_rbf_tg:0.5"
export QRD_SEEDS_OUT="beta_rbf_per_subject.csv"

( while true; do
    MEM=$(ps -u gv_nphuy -o rss= 2>/dev/null | awk '{s+=$1}END{printf "%.1fGB", s/1048576}')
    echo "[HB $(date +%T)] procmem=$MEM"
    sleep 600
  done ) &
HB=$!

timeout 37800 $PY $PROJ/scripts/run_seeds.py ; echo "rc=$?"
kill $HB 2>/dev/null

echo "rows: $(tail -n +2 $QRD_OUT_DIR/beta_rbf_per_subject.csv 2>/dev/null | wc -l) (dich 1545 = 3 run x 5 seed x 103 subject)"
echo "===== END $(date +%T) ====="
