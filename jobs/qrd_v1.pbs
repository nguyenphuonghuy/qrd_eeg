#!/bin/bash
#PBS -N qrd_v1_noproj
#PBS -q sharedgpu
#PBS -l select=1:ncpus=8:mem=64gb:gpu_slots=1
#PBS -l walltime=08:00:00
#PBS -j oe
LOG=/gpfs0/users/gv_nphuy/projects/qrd_eeg/logs/qrd_v1.log
mkdir -p "$(dirname "$LOG")"
exec > "$LOG" 2>&1
echo "===== START $(date +%T) $(date +%F) node=$(hostname) ====="
export PYTHONUNBUFFERED=1
export CUDA_MPS_PIPE_DIRECTORY=/dev/null
export MNE_DATA=/gpfs0/users/gv_nphuy/datasets/mne_data
export MNE_DATASETS_EEGBCI_PATH=/gpfs0/users/gv_nphuy/datasets/mne_data
PROJ=/gpfs0/users/gv_nphuy/projects/qrd_eeg
export ENSEMBLE_MI_DIR=$PROJ/external/Ensemble-MI
export QRD_TEACHER_DIR=$PROJ/checkpoints
export QRD_OUT_DIR=$PROJ/results
export QRD_DATASET=PhysionetMI
export QRD_SEEDS=1,2,3,4,5
export QRD_SEEDS_OUT=seeds_v1_per_subject.csv
export QRD_RUNS="qrd_dense_noproj:qrd_dense_noproj"
PY=/gpfs0/users/gv_nphuy/envs/qrd_env/bin/python
cd "$ENSEMBLE_MI_DIR" || { echo "LOI cd repo"; exit 2; }
echo "teacher ckpt: $(ls $QRD_TEACHER_DIR/teacher_fold0*.pth 2>/dev/null | wc -l)"
echo "-- xac nhan bien the ton tai --"
$PY -c "import importlib.util as u; s=u.spec_from_file_location('ta','$PROJ/scripts/train_all.py'); m=u.module_from_spec(s); s.loader.exec_module(m); print('qrd_dense_noproj:', m.METHOD_TABLE.get('qrd_dense_noproj'))"
( while true; do
    MEM=$(ps -u gv_nphuy -o rss= 2>/dev/null | awk '{s+=$1}END{printf "%.1fGB", s/1048576}')
    echo "[HB $(date +%T)] procmem=$MEM"
    sleep 300
  done ) &
HB=$!
echo "===== V1: 1 method x 5 seed x 5 fold x 30ep ====="
timeout 27000 $PY $PROJ/scripts/run_seeds.py ; echo "rc=$?"
kill $HB 2>/dev/null
echo "rows: $(tail -n +2 $QRD_OUT_DIR/seeds_v1_per_subject.csv 2>/dev/null | wc -l) (dich 515 = 5 x 103)"
echo "===== END $(date +%T) ====="
