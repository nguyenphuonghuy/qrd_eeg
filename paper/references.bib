@article{palumbo2021motorimagery,
  title = {Motor-{{Imagery EEG-Based BCIs}} in {{Wheelchair Movement}} and {{Control}}: {{A Systematic Literature Review}}},
  shorttitle = {Motor-{{Imagery EEG-Based BCIs}} in {{Wheelchair Movement}} and {{Control}}},
